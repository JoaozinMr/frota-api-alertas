{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=frota;Username=frota;Password=frota",
    "SchemaRetrySeconds": 3
  },
  "Alertas": {
    "RequestTimeoutMs": 2000,
    "DefaultLimit": 100,
    "MaxLimit": 1000
  },
  "AllowedHosts": "*"
}
